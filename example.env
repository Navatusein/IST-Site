MONGODB_URI=mongodb://user:password@address/ist

APP_PUBLIC_URL=http://localhost

# Reverse proxies in front of the app that append to X-Forwarded-For (rate limits use the address they saw).
# 0 when the app is reached directly: Next.js only fills X-Forwarded-For with the connection address when the
# client sent none, so without a proxy that overwrites the header the address can be forged and per-address limits
# are best-effort (the per-login limit still applies)
TRUSTED_PROXY_COUNT=1

# /test (component sandbox) outside `next dev`, e.g. on the develop server
ENABLE_TEST_PAGE=false

DEV_ORIGINS=localhost

ADMIN_LOGIN=admin
ADMIN_PASSWORD=admin

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=example@gamil.com
MAIL_PASSWORD=password
MAIL_FROM_NAME=Сайт кафедри ІСТ

# Who receives contact form messages, comma separated (MAIL_USERNAME when empty)
CONTACT_EMAIL_TO=ist@fit.knu.ua